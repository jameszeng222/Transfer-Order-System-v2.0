{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "migrate:make": "tsx node_modules/.bin/knex migrate:make --knexfile knexfile.ts -x ts",
    "migrate": "tsx node_modules/.bin/knex migrate:latest --knexfile knexfile.ts",
    "migrate:rollback": "tsx node_modules/.bin/knex migrate:rollback --knexfile knexfile.ts",
    "seed:make": "tsx node_modules/.bin/knex seed:make --knexfile knexfile.ts -x ts",
    "seed": "tsx node_modules/.bin/knex seed:run --knexfile knexfile.ts",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "knex": "^3.1.0",
    "better-sqlite3": "^11.7.0",
    "zod": "^3.23.8",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "xlsx": "^0.18.5",
    "axios": "^1.7.0",
    "node-cron": "^3.0.3",
    "tsx": "^4.19.0",
    "shared": "*"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "@types/better-sqlite3": "^7.6.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "vitest": "^2.1.0"
  }
}
